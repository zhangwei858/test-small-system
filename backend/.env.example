# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# 前端URL
FRONTEND_URL=http://localhost:8080

# JWT配置（如果后续需要用户认证）
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH=./uploads

# 考试配置
DEFAULT_TIME_LIMIT=1800  # 30分钟（秒）
CELEBRATION_SCORE=90